# Copied to server/.env by `npm run db:setup` (with a generated JWT_SECRET).

# API port (default 3001). If you change it, also export API_PORT so the Vite proxy follows.
# API_PORT=3001
DATABASE_URL=postgres://localhost:5432/dev_events

# Signs user and admin session tokens. Use a long random string.
JWT_SECRET=change-me
# Password for the /admin page (checked on the server).
ADMIN_PASSWORD=admin123

# --- Optional: event scraping (admin "Scrape", auto-scrape, fee backfill) ---
FIRECRAWL_API_KEY=
# Any OpenAI-compatible chat completions endpoint that supports tool calls.
AI_API_KEY=
AI_BASE_URL=https://ai.gateway.lovable.dev/v1
AI_MODEL=google/gemini-3-flash-preview
# Hours between automatic scrapes of saved sources (0 = off, 84 ≈ twice a week).
AUTO_SCRAPE_INTERVAL_HOURS=0
